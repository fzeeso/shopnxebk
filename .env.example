APP_NAME=shopnxebk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/shopnxebk/public
APP_TIMEZONE=UTC
FRONTEND_URL=http://localhost:3000
STORE_ADMIN_DASHBOARD_URL=http://localhost:3000/dashboard
STOREFRONT_ROOT_DOMAIN=shopnxe.com
STORE_DEFAULT_THEME_KEY=default
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password
FRONTEND_EMAIL_VERIFIED_URL=http://localhost:3000/email-verified
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SANCTUM_TOKEN_PREFIX=shopnxe_pat_
AUTH_TOKEN_TTL_MINUTES=43200
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=shopnxe
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_SSLMODE=prefer
DB_TIMEZONE=UTC
DB_POOL_URL=
DB_DIRECT_URL=
DB_APPLICATION_NAME=shopnxe
DB_READ_WRITE_SPLIT_ENABLED=false
DB_READ_HOSTS=127.0.0.1
DB_WRITE_HOSTS=127.0.0.1
DB_STICKY_READS=true

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_STORE=redis
LIGHTHOUSE_QUERY_CACHE_MODE=opcache
SESSION_DRIVER=redis
SESSION_CONNECTION=default
QUEUE_CONNECTION=redis
AUTH_MFA_CHALLENGE_TTL_SECONDS=300
AUTH_MFA_CHALLENGE_ATTEMPTS=5
AUTH_MFA_TOTP_WINDOW=1

SCOUT_DRIVER=database
SCOUT_QUEUE_CONNECTION=redis
SCOUT_QUEUE_NAME=search
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
MEILISEARCH_REQUIRED=false

OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5-mini
OPENAI_TRANSLATION_TIMEOUT=180
OPENAI_TRANSLATION_MAX_OUTPUT_TOKENS=16000
OPENAI_MEDIA_IMAGE_MODEL=gpt-image-2
OPENAI_MEDIA_ANALYSIS_MODEL=gpt-5-mini
OPENAI_MEDIA_TIMEOUT=240
OPENAI_MEDIA_MAX_OUTPUT_TOKENS=2000
OPENAI_MEDIA_QUALITY=medium
OPENAI_MEDIA_MAX_OUTPUT_BYTES=20971520
TRANSLATION_QUEUE_CONNECTION=redis
TRANSLATION_QUEUE=translations
REDIS_QUEUE_RETRY_AFTER=300
TRANSLATION_MAX_ATTEMPTS=3
TRANSLATION_RECOVERY_BATCH_SIZE=100
TRANSLATION_RECOVERY_AFTER_MINUTES=10

FILESYSTEM_DISK=private
MEDIA_DISK=private
MEDIA_CONVERSIONS_DISK=private
MEDIA_ALLOWED_DISKS=private,public,s3
MEDIA_MAX_FILE_SIZE_KB=10240
MEDIA_IMAGE_QUALITY=85
MEDIA_QUEUE=media
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=shopnxe
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=shopnxe-local
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false
OCTANE_DISCONNECT_DATABASES=false
OCTANE_COLLECT_GARBAGE=false
HORIZON_CRITICAL_MAX_PROCESSES=3
HORIZON_MAX_PROCESSES=5
HORIZON_TRANSLATION_MAX_PROCESSES=3
HORIZON_HEAVY_MAX_PROCESSES=2
PULSE_ENABLED=true
PULSE_STORAGE_KEEP="7 days"
INTERNAL_DASHBOARDS_ENABLED=false
INTERNAL_DASHBOARD_IP_ALLOW_LIST=127.0.0.1,::1
TELESCOPE_ENABLED=false
GRAPHQL_INTROSPECTION_ENABLED=true
GRAPHQL_MAX_DEPTH=12
GRAPHQL_MAX_COMPLEXITY=500
LIGHTHOUSE_DEBUG=0

# Reversible scale-readiness flags. Enable one at a time in AWS staging.
SCALABILITY_STORE_LOOKUP_CACHE_ENABLED=false
SCALABILITY_STORE_LOOKUP_CACHE_TTL_SECONDS=30
SCALABILITY_PRODUCT_DETAIL_REFERENCE_CACHE_ENABLED=false
SCALABILITY_PRODUCT_DETAIL_REFERENCE_CACHE_TTL_SECONDS=300
SCALABILITY_STORE_PRODUCT_RATE_LIMIT_ENABLED=false
SCALABILITY_STORE_PRODUCT_READS_PER_MINUTE=600
SCALABILITY_STORE_PRODUCT_WRITES_PER_MINUTE=120
SCALABILITY_REQUEST_PERFORMANCE_ENABLED=false
SCALABILITY_SLOW_REQUEST_MS=1000
SCALABILITY_REQUEST_SAMPLE_RATE=0.05
SCALABILITY_SERVER_TIMING_HEADER_ENABLED=false

# Enable only after the additive idempotency migration is explicitly applied.
# Use a dedicated random secret and keep it stable beyond the longest record TTL.
IDEMPOTENCY_ENABLED=false
IDEMPOTENCY_HMAC_KEY=
IDEMPOTENCY_TIER_A_MODE=supported
IDEMPOTENCY_DEFAULT_TTL_SECONDS=86400
IDEMPOTENCY_TIER_A_TTL_SECONDS=259200
IDEMPOTENCY_MAXIMUM_RESPONSE_BYTES=1048576
IDEMPOTENCY_PRUNE_BATCH_SIZE=1000
IDEMPOTENCY_PRUNE_MAXIMUM_BATCHES=10

LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=debug
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"
PLATFORM_ADMIN_NAME="Platform Test Administrator"
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
LOCAL_MERCHANT_NAME="Merchant Test User"
LOCAL_MERCHANT_EMAIL=
LOCAL_MERCHANT_PASSWORD=
LOCAL_MERCHANT_STORE_NAME="Merchant Test Store"
LOCAL_MERCHANT_STORE_SLUG=
