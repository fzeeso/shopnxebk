APP_NAME=shopnxebk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/shopnxebk/public
APP_TIMEZONE=UTC
FRONTEND_URL=http://localhost:3000
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password
FRONTEND_EMAIL_VERIFIED_URL=http://localhost:3000/email-verified
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SANCTUM_TOKEN_PREFIX=shopnxe_pat_
AUTH_TOKEN_TTL_MINUTES=43200
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=shopnxe
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_SSLMODE=prefer
DB_TIMEZONE=UTC
DB_POOL_URL=
DB_DIRECT_URL=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=default
QUEUE_CONNECTION=redis
AUTH_MFA_CHALLENGE_TTL_SECONDS=300
AUTH_MFA_CHALLENGE_ATTEMPTS=5
AUTH_MFA_TOTP_WINDOW=1

SCOUT_DRIVER=database
SCOUT_QUEUE_CONNECTION=redis
SCOUT_QUEUE_NAME=search
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
MEILISEARCH_REQUIRED=false

FILESYSTEM_DISK=private
MEDIA_DISK=private
MEDIA_CONVERSIONS_DISK=private
MEDIA_QUEUE=media
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=shopnxe
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=shopnxe-local
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false
HORIZON_MAX_PROCESSES=10
PULSE_ENABLED=true
PULSE_STORAGE_KEEP="7 days"
INTERNAL_DASHBOARDS_ENABLED=false
INTERNAL_DASHBOARD_IP_ALLOW_LIST=127.0.0.1,::1
TELESCOPE_ENABLED=false
GRAPHQL_INTROSPECTION_ENABLED=true
GRAPHQL_MAX_DEPTH=12
GRAPHQL_MAX_COMPLEXITY=500
LIGHTHOUSE_DEBUG=0

LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=debug
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"
PLATFORM_ADMIN_NAME="Platform Test Administrator"
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
LOCAL_MERCHANT_NAME="Merchant Test User"
LOCAL_MERCHANT_EMAIL=
LOCAL_MERCHANT_PASSWORD=
LOCAL_MERCHANT_STORE_NAME="Merchant Test Store"
LOCAL_MERCHANT_STORE_SLUG=
