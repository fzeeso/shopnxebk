{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "shopnxe/backend",
    "type": "project",
    "description": "ShopNXE modular SaaS commerce backend API.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "http-interop/http-factory-guzzle": "^1.2",
        "laravel/framework": "^13.8",
        "laravel/horizon": "^5.48",
        "laravel/octane": "^2.18",
        "laravel/pulse": "^1.7",
        "laravel/reverb": "^1.11",
        "laravel/sanctum": "^4.3",
        "laravel/scout": "^11.4",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.35",
        "meilisearch/meilisearch-php": "^1.16",
        "nuwave/lighthouse": "^6.69",
        "nwidart/laravel-modules": "^13.0",
        "predis/predis": "^3.5",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-multitenancy": "^4.1",
        "spatie/laravel-permission": "^8.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "laravel/telescope": "^5.21",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\Authentication\\": "Modules/Authentication/app/",
            "Modules\\Tenancy\\": "Modules/Tenancy/app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Modules\\Authentication\\Database\\Factories\\": "Modules/Authentication/database/factories/",
            "Modules\\Authentication\\Database\\Seeders\\": "Modules/Authentication/database/seeders/",
            "Modules\\Tenancy\\Database\\Factories\\": "Modules/Tenancy/database/factories/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan serve"
        ],
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:check": "pint --test",
        "horizon": "@php artisan horizon",
        "reverb": "@php artisan reverb:start",
        "octane": "@php artisan octane:start --server=frankenphp",
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/horizon",
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
